  "characters": [
    {
      "name": "Wren Halloway",
      "role": "Protagonist",
      "color": "#b0643c",
      "aliases": "the keeper’s girl",
      "summary": "Seventeen, stubborn, keeping her dead father’s lighthouse lit because nobody told her to stop.",
      "fields": [
        {
          "k": "Goal",
          "v": "Keep the light burning until the relief keeper comes."
        },
        {
          "k": "Motivation",
          "v": "If the light goes out, then he is really gone."
        },
        {
          "k": "Conflict",
          "v": "The oil is running out, and the harbour wants the light shut."
        },
        {
          "k": "Appearance",
          "v": "Salt-stiff braid, her father’s oilskin, cuffs rolled four times."
        },
        {
          "k": "Voice",
          "v": "Short sentences. Counts things when she is scared."
        }
      ],
      "notes": "",
      "id": "ch0hhy0yw1e4"
    },
    {
      "name": "Ansel Marr",
      "role": "Harbourmaster",
      "color": "#4f7f8f",
      "aliases": "the harbourmaster",
      "summary": "Kind in the way of men who have already decided what is best for you.",
      "fields": [
        {
          "k": "Goal",
          "v": "Close Skerry Light and bring Wren ashore."
        },
        {
          "k": "Motivation",
          "v": "He owes her father a debt nobody knows about."
        },
        {
          "k": "Conflict",
          "v": "Wren will not leave."
        },
        {
          "k": "Appearance",
          "v": ""
        },
        {
          "k": "Voice",
          "v": "Calls everyone “lass” or “lad”. Never raises his voice."
        }
      ],
      "notes": "",
      "id": "chz4r429w1e4"
    },
    {
      "name": "The Grey Man",
      "role": "Stranger",
      "color": "#8a5c9c",
      "aliases": "the stranger",
      "summary": "Came out of the fog in a boat with no oars. Knows the name of every keeper since 1840.",
      "fields": [
        {
          "k": "Goal",
          "v": "?"
        },
        {
          "k": "Appearance",
          "v": "Wet wool, no shoes, eyes the colour of the fog."
        }
      ],
      "notes": "Do not explain him too early.",
      "id": "chpee5wiw1e4"
    }
  ],
