  "notes": [
    {
      "title": "Rules of the light",
      "content": "<p>Lamp lit at sunset, by the tables. Never late.</p><p>Wick trimmed every four hours.</p><p>The log is written in ink, never pencil, and never torn.</p><p><em>Ideas:</em> the log could be how the Grey Man proves who he is.</p>",
      "id": "n9uzn8iw1e4"
    }
  ],
