          ],
          "when": "Day 2, noon",
          "notes": "",
          "content": "<p><br></p>"
        },
        {
          "id": "sccngp0w1e4",
          "title": "What the tide brought",
          "status": "idea",
          "synopsis": "In Port Caddow, Ansel finds something on the strand that should have gone down with Wren’s father.",
          "pov": "chz4r429w1e4",
          "characters": [
